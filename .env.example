# Copy this file to .env.local and fill in your Supabase project values.
#
#   Supabase dashboard > Settings > API
#
# Both variables are NEXT_PUBLIC_ because the browser client needs them. The
# publishable (anon) key is safe in the browser — Row Level Security is what
# protects the data.
#
# NEVER put the service_role key in this project. It bypasses RLS entirely and
# would let any shop read every other shop's data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
